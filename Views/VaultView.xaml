<UserControl x:Class="Zavrsni.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Zavrsni.Views"
             mc:Ignorable="d" 
 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Accent color used across the app -->
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#22262E" />
        <SolidColorBrush x:Key="BorderBrush2" Color="#34394420" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA1AC" />

        <!-- Primary action button (Encrypt / Choose file) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3A3F4A" />
                    <Setter Property="Foreground" Value="#6B7280" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary / neutral button (Decrypt, Cancel) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2C313A" />
            <Setter Property="Foreground" Value="#E6E8EB" />
        </Style>

        <!-- Cancel uses a quiet red so it reads as a stop action without shouting -->
        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3A2628" />
            <Setter Property="Foreground" Value="#E08A8A" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Title -->
            <RowDefinition Height="28" />
            <!-- spacer -->
            <RowDefinition Height="Auto" />
            <!-- File picker row -->
            <RowDefinition Height="20" />
            <!-- spacer -->
            <RowDefinition Height="Auto" />
            <!-- Action buttons -->
            <RowDefinition Height="24" />
            <!-- spacer -->
            <RowDefinition Height="Auto" />
            <!-- Progress row -->
            <RowDefinition Height="12" />
            <!-- spacer -->
            <RowDefinition Height="Auto" />
            <!-- Status text -->
            <RowDefinition Height="*" />
            <!-- fill remaining space -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Secure File Vault"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="White" />
            <TextBlock Text="Choose a file to encrypt or decrypt"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- File picker -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="8"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="Path"
                        Grid.Column="0"
                        Content="Choose file"
                        Style="{StaticResource SecondaryButton}"
                        Width="120" />

                <TextBlock x:Name="ChosenFilepath"
                           Grid.Column="1"
                           Text="No file chosen yet"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="EncryptBtn"
                    Content="Encrypt"
                    Style="{StaticResource PrimaryButton}"
                    Width="130" />

            <Button x:Name="DecryptBtn"
                    Content="Decrypt"
                    Style="{StaticResource SecondaryButton}"
                    Width="130"
                    Margin="12,0,0,0" />

            <Button x:Name="Cancel"
                    Content="Cancel"
                    Style="{StaticResource CancelButton}"
                    Width="100"
                    Margin="12,0,0,0" />

            <Button x:Name="Logout"
                    Content="Logout"
                    Style="{StaticResource SecondaryButton}"
                    Width="100"
                    Margin="12,0,0,0" />
        </StackPanel>

        <!-- Progress -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="PROGRESS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
            <ProgressBar Value="{Binding ProgressBarV}"
                         Height="6"
                         Minimum="0" Maximum="100"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0" />
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="8"
                   Text="{Binding Notification}"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}" />

    </Grid>
</UserControl>
