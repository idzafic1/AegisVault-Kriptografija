<UserControl x:Class="Zavrsni.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Zavrsni.Views"

             xmlns:helpers="clr-namespace:Zavrsni.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="640">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
            <!-- Header -->
            <TextBlock Text="Secure File Vault"
                       FontSize="24" FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock Text="Please log in to continue"
                       FontSize="12"
                       Foreground="#9AA1AC"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28" />

            <!-- Password -->
            <TextBlock Text="PASSWORD" FontSize="11" FontWeight="SemiBold"
                       Foreground="#9AA1AC" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordView"
                         helpers:PasswordHelper.Attach="True"
                         helpers:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         FontSize="13"
                         Background="#22262E"
                         Foreground="White"
                         BorderBrush="#34394420"
                         BorderThickness="1"
                         Margin="0,0,0,24" />

            <!-- Error message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#E08A8A"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Login button -->
            <Button x:Name="Login"
                    Content="Login"
                    Height="38"
                    FontSize="13" FontWeight="SemiBold"
                    Foreground="White"
                    Background="#5B8DEF"
                    BorderThickness="0"
                    Cursor="Hand" />

            <!-- Indeterminate progress bar — vidljiv dok traje Argon2id derivacija -->
            <ProgressBar IsIndeterminate="{Binding IsBusy}"
                         Height="3"
                         Margin="0,8,0,0"
                         Background="Transparent"
                         Foreground="#5B8DEF"
                         BorderThickness="0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

            <!-- Register link -->
            <Button x:Name="GoToRegister"
                    Content="Don't have an account? Register"
                    Background="Transparent"
                    Foreground="#5B8DEF"
                    FontSize="12"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
